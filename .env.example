# Optional overrides for docker-compose.yml. Copy to `.env` and edit.
# Every value has a default in docker-compose.yml, so `.env` is not required.

# The one API client (used to log in on the web page).
CLIENT_ID=demo-client
CLIENT_SECRET=demo-secret

# Secret that signs login tokens. Use a long random value, at least 32 characters.
# Generate one in Git Bash with: openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-long-random-value-0123456789

# Login token lifetime in seconds. A short value (e.g. 20) helps test silent token renewal.
TOKEN_TTL_SECONDS=300

# Share of vendor uploads that fail on purpose (0 = never, 1 = always).
# A job run fails only when all 3 attempts fail: 0.6 fails about 22% of runs, 0.3 (the brief's rate) about 3%.
VENDOR_FAILURE_RATE=0.6

# Documents the Source stub creates on its first start. Only used when its data is empty,
# so reset with `docker compose down -v` (this deletes all jobs, archives and vendor deliveries too).
SEED_DOCUMENTS=100
